# Backend (variables de la Lambda). Valores de ejemplo, no reales.
# Perfil local: copiar a backend/.env o exportar. En AWS estas variables las define SAM.
TABLE_DEVICES=devices
TABLE_PATIENTS=patients
TABLE_MEASUREMENTS=measurements
GMAIL_USER=cuenta.proyecto@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ALLOWED_ORIGIN=http://localhost:5173
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio
TEMP_LOW_C=35
TEMP_HIGH_C=38
SPO2_MIN=92
LOG_LEVEL=INFO

# Solo perfil local (base moto_server). En AWS NO se definen.
DYNAMODB_ENDPOINT=http://localhost:8001
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_DEFAULT_REGION=us-east-1

# Frontend
VITE_API_URL=http://localhost:8000
