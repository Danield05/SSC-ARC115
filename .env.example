# Backend (variables de la Lambda). Los secretos van vacíos: nunca se escriben aquí.
# Perfil local: copiar a backend/.env o exportar. En AWS estas variables las define SAM.
TABLE_DEVICES=devices
TABLE_PATIENTS=patients
TABLE_MEASUREMENTS=measurements
TABLE_USERS=users
GMAIL_USER=cuenta.proyecto@gmail.com
GMAIL_APP_PASSWORD=
ALLOWED_ORIGIN=http://localhost:5173
JWT_SECRET=
TEMP_LOW_C=35
TEMP_HIGH_C=38
SPO2_MIN=92
LOG_LEVEL=INFO

# Solo perfil local (base moto_server). En AWS NO se definen.
DYNAMODB_ENDPOINT=http://localhost:8001
AWS_DEFAULT_REGION=us-east-1
# La base local exige credenciales, pero acepta cualquier valor: definir
# AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY en la terminal (no en este archivo).

# Frontend
VITE_API_URL=http://localhost:8000
